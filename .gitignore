# Raw data is not committed (public, downloaded, regenerated by src/clean.py)
data/raw/*
!data/raw/README.md

# Processed data: the tidy CSV is small (~1MB) and committed so a fresh
# clone / cloud deploy has something to build the dashboard's DuckDB from
# without needing the raw files present. Anything else here isn't.
data/processed/*
!data/processed/ae_attendances_tidy.csv

# Outputs
outputs/*
!outputs/.gitkeep

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# DuckDB
*.duckdb
